<Window x:Class="SimpleCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="280" Width="300">
    <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">

        <TextBox x:Name="Input1" Margin="0,5" FontSize="20" Text="Число 1"/>
        <TextBox x:Name="Input2" Margin="0,5" FontSize="20" Text="Число 2"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="+" Width="50" Margin="5" Click="AddClick"/>
            <Button Content="-" Width="50" Margin="5" Click="SubtractClick"/>
            <Button Content="*" Width="50" Margin="5" Click="MultiplyClick"/>
            <Button Content="/" Width="50" Margin="5" Click="DivideClick"/>
        </StackPanel>

        <TextBlock x:Name="ResultText" FontSize="24" Margin="0,10" TextAlignment="Center"/>
    </StackPanel>
</Window>
